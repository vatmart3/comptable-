// SOLDE — schéma comptable.
//
// Deux partis pris structurants :
//
// 1. AUCUN `enum` Prisma, AUCUN attribut natif (`@db.*`). Le schéma est donc
//    portable tel quel : `provider = "sqlite"` pour le dev local, `"postgresql"`
//    en production, sans toucher une seule ligne de modèle. Les domaines de
//    valeurs sont tenus par Zod dans `lib/accounting/*` (source de vérité unique).
//
// 2. TOUS LES MONTANTS SONT DES ENTIERS EN CENTIMES (`Int`). La comptabilité
//    n'admet pas l'erreur de virgule flottante : 0.1 + 0.2 !== 0.3 est une
//    fraude comptable involontaire. Le moteur (`lib/accounting/money.ts`) ne
//    manipule jamais autre chose que des centimes. Plafond : 21 474 836,47 €
//    par ligne, très au-delà de la cible TPE/PME ; les agrégats sont calculés
//    en `number` JS (sûr jusqu'à 90 000 milliards d'euros).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// IDENTITÉ / MULTI-TENANT
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships Membership[]
  sessions    Session[]
  accounts    AuthAccount[]
  auditLogs   AuditLog[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model AuthAccount {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Rôle : "saisie" | "reviseur" | "expert" | "lecture" (cf. lib/accounting/roles.ts)
model Membership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SOCIÉTÉ ET EXERCICES
// ─────────────────────────────────────────────────────────────────────────────

model Company {
  id               String   @id @default(cuid())
  nom              String
  siret            String   @unique
  /// Les 9 premiers chiffres du SIRET. Sert au nommage du fichier FEC.
  siren            String
  formeJuridique   String?
  adresse          String?
  codePostal       String?
  ville            String?
  /// "BIC" | "BNC"
  categorieRevenu  String   @default("BIC")
  /// "micro" | "reel_simplifie" | "reel_normal"
  regimeImposition String   @default("reel_simplifie")
  /// "franchise" | "reel_simplifie" | "reel_normal" | "mini_reel"
  regimeTva        String   @default("reel_normal")
  /// "debits" | "encaissements" — exigibilité de la TVA collectée.
  exigibiliteTva   String   @default("debits")
  numeroTvaIntra   String?
  devise           String   @default("EUR")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  fiscalYears     FiscalYear[]
  accounts        Account[]
  journals        Journal[]
  entries         Entry[]
  lines           Line[]
  partners        Partner[]
  documents       Document[]
  invoices        Invoice[]
  bankAccounts    BankAccount[]
  assets          Asset[]
  vatDeclarations VatDeclaration[]
  analyticAxes    AnalyticAxis[]
  memberships     Membership[]
  auditLogs       AuditLog[]
  aiSuggestions   AiSuggestion[]
  templates       EntryTemplate[]
}

/// Un exercice comptable. `statut` : "ouvert" | "en_cloture" | "cloture".
model FiscalYear {
  id                   String    @id @default(cuid())
  companyId            String
  libelle              String
  dateDebut            DateTime
  dateFin              DateTime
  statut               String    @default("ouvert")
  reportANouveauGenere Boolean   @default(false)
  clotureLe            DateTime?
  createdAt            DateTime  @default(now())

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entries         Entry[]
  depreciations   Depreciation[]
  vatDeclarations VatDeclaration[]

  @@unique([companyId, dateDebut])
  @@index([companyId, dateFin])
}

// ─────────────────────────────────────────────────────────────────────────────
// PLAN COMPTABLE
// ─────────────────────────────────────────────────────────────────────────────

/// Compte du PCG. `classe` est dérivée du premier caractère du numéro mais
/// stockée pour permettre l'agrégation en base sans fonction SQL.
model Account {
  id             String  @id @default(cuid())
  companyId      String
  numero         String
  libelle        String
  classe         Int
  /// "bilan" | "gestion" — classes 1-5 vs 6-7. La classe 8 est "special".
  nature         String
  /// Sens naturel du solde : "debit" | "credit" | "mixte".
  sensNaturel    String  @default("mixte")
  lettrable      Boolean @default(false)
  /// Compte auxiliaire (411XXX / 401XXX rattaché à un Partner).
  auxiliaire     Boolean @default(false)
  actif          Boolean @default(true)
  /// Taux de TVA attendu en millièmes de pourcent (20000 = 20,00 %). Sert au
  /// radar d'anomalies : une TVA à 5,5 % sur un compte 606 est suspecte.
  tauxTvaAttendu Int?
  compteParentId String?

  company             Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  compteParent        Account?      @relation("SousComptes", fields: [compteParentId], references: [id])
  sousComptes         Account[]     @relation("SousComptes")
  lines               Line[]
  partnersClient      Partner[]     @relation("CompteClient")
  partnersFournisseur Partner[]     @relation("CompteFournisseur")
  bankAccounts        BankAccount[]
  journals            Journal[]

  @@unique([companyId, numero])
  @@index([companyId, classe])
  @@index([companyId, actif])
}

/// Journal. `type` : "achat" | "vente" | "banque" | "caisse" | "od" | "anouveaux".
model Journal {
  id                   String  @id @default(cuid())
  companyId            String
  code                 String
  libelle              String
  type                 String
  compteContrepartieId String?
  actif                Boolean @default(true)

  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  compteContrepartie Account? @relation(fields: [compteContrepartieId], references: [id])
  entries            Entry[]

  @@unique([companyId, code])
}

// ─────────────────────────────────────────────────────────────────────────────
// ÉCRITURES — LE REGISTRE INVIOLABLE
// ─────────────────────────────────────────────────────────────────────────────

/// Une écriture. Invariants tenus par le moteur ET par la base :
///  - somme(débits) == somme(crédits) (vérifié en transaction avant commit) ;
///  - `numero` est une séquence continue par (journal, exercice), sans trou ;
///  - une écriture "validee" est immuable : correction = contre-passation ;
///  - `hash = SHA256(empreinte canonique + hashPrecedent)` — chaînage global
///    par société, dans l'ordre de validation. Toute altération casse la chaîne.
model Entry {
  id            String    @id @default(cuid())
  companyId     String
  fiscalYearId  String
  journalId     String
  /// Null tant que l'écriture est au brouillon : un brouillon n'a pas encore de
  /// numéro légal. Numéroter à la création puis supprimer le brouillon
  /// creuserait un trou dans la séquence — donc une présomption de suppression
  /// d'écriture. Le numéro est attribué au moment de la validation, sous verrou.
  numero        Int?
  date          DateTime
  libelle       String
  pieceRef      String?
  /// "brouillon" | "validee"
  statut        String    @default("brouillon")
  /// Rang dans la chaîne cryptographique de la société (1, 2, 3…). Null tant
  /// que l'écriture est au brouillon.
  chainIndex    Int?
  hash          String?
  hashPrecedent String?
  /// Écriture de contre-passation : pointe vers l'écriture annulée.
  contrepasseId String?   @unique
  /// Marque une écriture générée par le système (à-nouveaux, dotations, TVA).
  origine       String    @default("saisie")
  createdById   String?
  createdAt     DateTime  @default(now())
  validatedAt   DateTime?
  validatedById String?

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear       FiscalYear        @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  journal          Journal           @relation(fields: [journalId], references: [id])
  lines            Line[]
  documents        Document[]
  invoice          Invoice?
  bankTransactions BankTransaction[]
  depreciation     Depreciation?
  vatDeclaration   VatDeclaration?
  contrepasse      Entry?            @relation("Contrepassation", fields: [contrepasseId], references: [id])
  contrepassePar   Entry?            @relation("Contrepassation")

  @@unique([companyId, journalId, fiscalYearId, numero])
  @@unique([companyId, chainIndex])
  @@unique([companyId, hash])
  @@index([companyId, date])
  @@index([companyId, journalId, date])
  @@index([companyId, statut])
  @@index([fiscalYearId, date])
}

/// Une ligne d'écriture. Exactement un des deux montants est non nul
/// (contrainte applicative + test : `assertLineSided`).
model Line {
  id                String    @id @default(cuid())
  companyId         String
  entryId           String
  accountId         String
  /// Centimes. Toujours >= 0.
  debit             Int       @default(0)
  credit            Int       @default(0)
  libelle           String
  /// Ordre d'affichage dans l'écriture.
  position          Int       @default(0)
  /// Lettrage : A, B, … AA. Null = non lettré.
  lettre            String?
  dateLettrage      DateTime?
  /// Échéance de la ligne (utile aux 401/411 pour la prévision de trésorerie).
  echeance          DateTime?
  partnerId         String?
  analyticSectionId String?

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entry           Entry            @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account         Account          @relation(fields: [accountId], references: [id])
  partner         Partner?         @relation(fields: [partnerId], references: [id])
  analyticSection AnalyticSection? @relation(fields: [analyticSectionId], references: [id])

  @@index([companyId, accountId])
  @@index([entryId])
  @@index([companyId, lettre])
  @@index([companyId, partnerId])
  @@index([companyId, echeance])
}

/// Modèle d'écriture récurrente / écriture type.
model EntryTemplate {
  id        String   @id @default(cuid())
  companyId String
  nom       String
  journalId String?
  /// Lignes du modèle, en JSON : [{ numeroCompte, sens, libelle, ratio? }]
  payload   String
  /// "manuel" | "mensuel" | "trimestriel" | "annuel"
  frequence String   @default("manuel")
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, nom])
}

// ─────────────────────────────────────────────────────────────────────────────
// TIERS, PIÈCES, FACTURATION
// ─────────────────────────────────────────────────────────────────────────────

model Partner {
  id                  String   @id @default(cuid())
  companyId           String
  /// "client" | "fournisseur" | "les_deux"
  type                String
  code                String
  nom                 String
  siret               String?
  tvaIntra            String?
  email               String?
  telephone           String?
  adresse             String?
  codePostal          String?
  ville               String?
  /// Délai de règlement en jours (art. L441-10 : 30 jours par défaut).
  delaiReglement      Int      @default(30)
  /// "fin_de_mois" | "date_facture"
  modeReglement       String   @default("date_facture")
  compteClientId      String?
  compteFournisseurId String?
  actif               Boolean  @default(true)
  createdAt           DateTime @default(now())

  company           Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  compteClient      Account?   @relation("CompteClient", fields: [compteClientId], references: [id])
  compteFournisseur Account?   @relation("CompteFournisseur", fields: [compteFournisseurId], references: [id])
  invoices          Invoice[]
  lines             Line[]
  documents         Document[]

  @@unique([companyId, code])
  @@index([companyId, type])
}

/// Justificatif. `type` : "facture_achat" | "facture_vente" | "releve" | "justificatif".
/// `statut` : "recu" | "lu" | "rattache" | "rejete".
model Document {
  id        String   @id @default(cuid())
  companyId String
  nom       String
  type      String
  mimeType  String
  taille    Int
  /// Chemin de stockage (objet S3 / disque). Jamais le binaire en base.
  chemin    String
  /// Sortie brute de l'extraction vision, en JSON (zones + valeurs + bbox).
  ocrJson   String?
  statut    String   @default("recu")
  entryId   String?
  partnerId String?
  createdAt DateTime @default(now())

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entry   Entry?   @relation(fields: [entryId], references: [id])
  partner Partner? @relation(fields: [partnerId], references: [id])

  @@index([companyId, statut])
  @@index([entryId])
}

/// Facture de vente. `statut` : "devis" | "brouillon" | "emise" | "payee" | "annulee".
/// `type` : "facture" | "avoir" | "devis".
model Invoice {
  id           String   @id @default(cuid())
  companyId    String
  partnerId    String
  type         String   @default("facture")
  numero       String
  dateEmission DateTime
  dateEcheance DateTime
  /// Centimes.
  totalHt      Int
  totalTva     Int
  totalTtc     Int
  /// Détail de TVA par taux, JSON : [{ taux, base, montant }]
  tvaDetail    String
  statut       String   @default("brouillon")
  mentions     String?
  entryId      String?  @unique
  createdAt    DateTime @default(now())

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partner Partner       @relation(fields: [partnerId], references: [id])
  entry   Entry?        @relation(fields: [entryId], references: [id])
  lignes  InvoiceLine[]

  @@unique([companyId, numero])
  @@index([companyId, statut])
  @@index([companyId, dateEcheance])
}

model InvoiceLine {
  id                String @id @default(cuid())
  invoiceId         String
  designation       String
  quantite          Int    @default(1000)
  /// Prix unitaire HT en centimes. `quantite` est en millièmes d'unité.
  prixUnitaire      Int
  /// Taux de TVA en millièmes de pourcent : 20000 = 20 %.
  tauxTva           Int    @default(20000)
  remise            Int    @default(0)
  position          Int    @default(0)
  compteVenteNumero String @default("706000")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// BANQUE
// ─────────────────────────────────────────────────────────────────────────────

model BankAccount {
  id           String  @id @default(cuid())
  companyId    String
  libelle      String
  banque       String
  iban         String
  bic          String?
  /// Centimes, signé.
  soldeInitial Int     @default(0)
  compteId     String?
  actif        Boolean @default(true)

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  compte       Account?          @relation(fields: [compteId], references: [id])
  transactions BankTransaction[]

  @@unique([companyId, iban])
}

/// Ligne de relevé. `statut` : "non_rapprochee" | "rapprochee" | "ignoree".
model BankTransaction {
  id            String    @id @default(cuid())
  companyId     String
  bankAccountId String
  date          DateTime
  dateValeur    DateTime?
  libelle       String
  /// Centimes, signé : négatif = débit du compte bancaire (décaissement).
  montant       Int
  reference     String?
  statut        String    @default("non_rapprochee")
  entryId       String?
  /// Score de rapprochement IA, 0..1000 (millièmes). > 920 = proposé groupé.
  matchScore    Int?
  /// Empreinte (date+montant+libellé) pour l'idempotence des imports.
  importHash    String
  createdAt     DateTime  @default(now())

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  entry       Entry?      @relation(fields: [entryId], references: [id])

  @@unique([bankAccountId, importHash])
  @@index([companyId, statut])
  @@index([bankAccountId, date])
}

// ─────────────────────────────────────────────────────────────────────────────
// IMMOBILISATIONS
// ─────────────────────────────────────────────────────────────────────────────

/// `mode` : "lineaire" | "degressif" | "non_amortissable".
/// `statut` : "en_service" | "cede" | "mis_au_rebut" | "totalement_amorti".
model Asset {
  id                String    @id @default(cuid())
  companyId         String
  code              String
  libelle           String
  /// Compte d'immobilisation (2xxxxx) et compte d'amortissement (28xxxx).
  compteImmoNumero  String
  compteAmortNumero String
  /// Centimes, HT.
  valeurBrute       Int
  valeurResiduelle  Int       @default(0)
  dateAcquisition   DateTime
  dateMiseEnService DateTime
  /// Durée d'amortissement en mois (60 = 5 ans). Le mois évite les arrondis
  /// d'année sur les mises en service en cours d'exercice (prorata temporis).
  dureeMois         Int
  mode              String    @default("lineaire")
  statut            String    @default("en_service")
  dateCession       DateTime?
  prixCession       Int?
  createdAt         DateTime  @default(now())

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  depreciations Depreciation[]

  @@unique([companyId, code])
  @@index([companyId, statut])
}

model Depreciation {
  id           String  @id @default(cuid())
  assetId      String
  fiscalYearId String
  /// Dotation de l'exercice, en centimes.
  dotation     Int
  /// Cumul des amortissements à la fin de l'exercice.
  cumule       Int
  /// Valeur nette comptable en fin d'exercice.
  vnc          Int
  entryId      String? @unique
  comptabilise Boolean @default(false)

  asset      Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  entry      Entry?     @relation(fields: [entryId], references: [id])

  @@unique([assetId, fiscalYearId])
}

// ─────────────────────────────────────────────────────────────────────────────
// TVA
// ─────────────────────────────────────────────────────────────────────────────

/// `regime` : "CA3" (mensuelle/trimestrielle, réel normal) | "CA12" (réel simplifié).
/// `statut` : "brouillon" | "validee" | "teletransmise".
model VatDeclaration {
  id           String   @id @default(cuid())
  companyId    String
  fiscalYearId String
  regime       String   @default("CA3")
  periodeDebut DateTime
  periodeFin   DateTime
  /// Cases CA3 calculées, JSON : { "01": 12345, "08": …, "20": …, "TD": … }
  /// Montants en centimes ; l'export CERFA arrondit à l'euro.
  cases        String
  /// TVA nette due (positif) ou crédit de TVA (négatif), en centimes.
  tvaNette     Int
  statut       String   @default("brouillon")
  entryId      String?  @unique
  createdAt    DateTime @default(now())

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  entry      Entry?     @relation(fields: [entryId], references: [id])

  @@unique([companyId, periodeDebut, periodeFin])
}

// ─────────────────────────────────────────────────────────────────────────────
// ANALYTIQUE
// ─────────────────────────────────────────────────────────────────────────────

model AnalyticAxis {
  id          String  @id @default(cuid())
  companyId   String
  code        String
  libelle     String
  /// Rend la ventilation obligatoire sur les comptes de gestion.
  obligatoire Boolean @default(false)

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sections AnalyticSection[]

  @@unique([companyId, code])
}

model AnalyticSection {
  id      String  @id @default(cuid())
  axisId  String
  code    String
  libelle String
  actif   Boolean @default(true)

  axis  AnalyticAxis @relation(fields: [axisId], references: [id], onDelete: Cascade)
  lines Line[]

  @@unique([axisId, code])
}

// ─────────────────────────────────────────────────────────────────────────────
// PISTE D'AUDIT ET IA
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  userId    String?
  /// "create" | "update" | "delete" | "validate" | "lettrage" | "cloture" | "export"
  action    String
  /// Nom du modèle visé + identifiant.
  cible     String
  cibleId   String?
  avant     String?
  apres     String?
  ip        String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@index([companyId, cible, cibleId])
}

/// Toute sortie d'IA transite par ici avant d'exister comptablement.
/// `type` : "saisie_nl" | "ocr" | "categorisation" | "rapprochement" |
///          "anomalie" | "question" | "previsionnel" | "synthese" | "cloture"
/// `statut` : "proposee" | "acceptee" | "rejetee" | "expiree"
model AiSuggestion {
  id         String    @id @default(cuid())
  companyId  String
  type       String
  /// Proposition structurée, JSON validé par Zod avant persistance.
  payload    String
  /// Confiance en millièmes : 940 = 94,0 %.
  confiance  Int
  /// Le « pourquoi » en une phrase, affiché à l'utilisateur.
  raison     String
  statut     String    @default("proposee")
  /// Correction humaine, JSON. C'est la mémoire de la catégorisation apprenante.
  feedback   String?
  /// Clé d'apprentissage : normalisation du libellé/fournisseur.
  cleAppren  String?
  cibleId    String?
  /// Coût de l'appel en millièmes de centime d'euro, et tokens consommés.
  coutMilli  Int?
  tokensIn   Int?
  tokensOut  Int?
  modele     String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, type, statut])
  @@index([companyId, cleAppren])
}
